# Copy file này thành src/semgrep/.env rồi điền API key thật.
# Không commit file .env chứa secret.

AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible provider, ví dụ OpenRouter hoặc LiteLLM proxy.
# AI_PROVIDER=openai-compatible
# AI_MODEL=deepseek/deepseek-chat
# OPENAI_API_KEY=your_openai_compatible_api_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
