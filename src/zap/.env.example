# Copy file này thành src/zap/.env để chạy local.
# Không commit credential/API key thật vào git.

# Target scan và ZAP daemon
ZAP_TARGET=http://localhost:3000
ZAP_URL=http://localhost:8090
ZAP_API_KEY=
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable

# Chế độ scan và authentication
# ZAP_AUTH_ROLE: none, user hoặc admin
ZAP_AUTH_ROLE=none
ZAP_FORCED_USER=false
ZAP_AJAX_SPIDER=false

# Output report
# ZAP_REPORT_FORMAT: html để đọc thủ công hoặc json cho pipeline/AI
ZAP_REPORT_FORMAT=html
ZAP_REPORT_FILE=src/zap/output/zap_scan_report.html

# Credential cho authenticated scan bằng seed user local/CI
ZAP_USER_EMAIL=test@eshop.com
ZAP_USER_PASSWORD=change-me
ZAP_ADMIN_EMAIL=admin@eshop.com
ZAP_ADMIN_PASSWORD=change-me

# Triage AI tùy chọn qua OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_TOKENS=4096

# OPEN AI
OPENAI_API_KEY=
# Tùy chọn nâng cao để tùy biến mục tiêu (Chỉ sửa khi thay đổi port/host EShop)
# ZAP_ALLOWED_HOSTS=localhost,127.0.0.1
# ZAP_ALLOWED_PORTS=3000,5173,5174
# ZAP_CONTEXT_NAME=EShop
# ZAP_CONTEXT_REGEX=^http://(?:localhost|127\.0\.0\.1):(?:3000|5173|5174)(?:[/?#].*)?$
# ESHOP_LOGIN_URL=http://localhost:3000/api/login
# ESHOP_VERIFY_URL=http://localhost:3000/api/users/me
# ZAP_REPLACER_RULE=EShop JWT Authorization
# ZAP_TRIAGE_OUTPUT_FILE=src/zap/output/zap_ai_triage_report.md
# ZAP_SUBMISSION_FILE=submission/Team_Work_Assignment.md
