# Copy this file to src/zap/.env for local runs.
# Keep real credentials/API keys out of git.

# Scan target and ZAP daemon
ZAP_TARGET=http://localhost:3000
ZAP_URL=http://localhost:8090
ZAP_API_KEY=
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable

# Scan mode
# ZAP_AUTH_ROLE: none, user, or admin
ZAP_AUTH_ROLE=none
ZAP_FORCED_USER=false
ZAP_AJAX_SPIDER=false
ZAP_EXTERNAL_ZAP=false

# Report output
# ZAP_REPORT_FORMAT: html, json, xml, or md
ZAP_REPORT_FORMAT=html
ZAP_REPORT_FILE=src/zap/output/zap_scan_report.html

# Authenticated scan credentials for local/CI seed users
ZAP_USER_EMAIL=test@eshop.com
ZAP_USER_PASSWORD=change-me
ZAP_ADMIN_EMAIL=admin@eshop.com
ZAP_ADMIN_PASSWORD=change-me

# Optional AI triage through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
