# Copy file này thành .env rồi điền API key thật.
# Không commit file .env chứa secret.

# Provider mặc định của nhóm: OpenRouter dùng model Gemini qua endpoint OpenAI-compatible.
AI_PROVIDER=openai-compatible
AI_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Nếu muốn gọi Gemini trực tiếp qua Google AI Studio, đổi cấu hình thành:
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here
