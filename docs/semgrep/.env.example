# Copy file này thành .env rồi điền API key thật.
# Không commit file .env chứa secret.

# Provider mặc định: gemini
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Nếu dùng provider OpenAI-compatible, đổi AI_PROVIDER và điền các biến dưới đây.
# Ví dụ: OpenRouter, LiteLLM proxy, hoặc endpoint tương thích /chat/completions.
# AI_PROVIDER=openai-compatible
# AI_MODEL=deepseek/deepseek-chat
# OPENAI_API_KEY=your_openai_compatible_api_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
