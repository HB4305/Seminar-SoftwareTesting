# Copy file này thành src/zap/.env để chạy local.
# Không commit credential/API key thật vào git.

# Target scan và ZAP daemon
ZAP_TARGET=http://localhost:3000
ZAP_URL=http://localhost:8090
ZAP_API_KEY=
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable

# Chế độ scan và authentication
# ZAP_AUTH_ROLE: none, user hoặc admin
ZAP_AUTH_ROLE=none
ZAP_FORCED_USER=false
ZAP_AJAX_SPIDER=false
ZAP_EXTERNAL_ZAP=false
# ZAP_SCAN_MODE: basic dùng rule mặc định; owasp-top10-2025 tạo policy theo tag OWASP_2025_A*
ZAP_SCAN_MODE=basic

# Output report
# ZAP_REPORT_FORMAT: html để đọc thủ công hoặc json cho pipeline/AI
ZAP_REPORT_FORMAT=html
ZAP_REPORT_FILE=src/zap/output/zap_scan_report.html

# Credential cho authenticated scan bằng seed user local/CI
ZAP_USER_EMAIL=test@eshop.com
ZAP_USER_PASSWORD=change-me
ZAP_ADMIN_EMAIL=admin@eshop.com
ZAP_ADMIN_PASSWORD=change-me

# Triage AI tùy chọn qua OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
